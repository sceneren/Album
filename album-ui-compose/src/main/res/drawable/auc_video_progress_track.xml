<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <size android:height="@dimen/auc_video_progress_height" />
            <corners android:radius="3dp" />
            <solid android:color="@color/auc_video_progress_unplayed" />
        </shape>
    </item>
    <!-- Fill through the thumb's far edge, not just progress * track width. This keeps
         the two rounded shapes fully overlapped even at the first non-zero progress. -->
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale
            android:scaleGravity="left"
            android:scaleWidth="100%"
            android:useIntrinsicSizeAsMinimum="true">
            <shape>
                <size
                    android:width="@dimen/auc_video_progress_thumb_width"
                    android:height="@dimen/auc_video_progress_height" />
                <corners android:radius="3dp" />
                <solid android:color="@color/auc_video_controls_foreground" />
            </shape>
        </scale>
    </item>
</layer-list>
