<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="@dimen/auv_video_progress_height" />
            <solid android:color="@color/auv_video_progress_unplayed" />
            <corners android:radius="@dimen/auv_video_progress_radius" />
        </shape>
    </item>
    <!-- The fill includes the thumb width so its rounded end cannot leave a notch
         between the starting segment and the capsule at low playback positions. -->
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale
            android:scaleGravity="left"
            android:scaleWidth="100%"
            android:useIntrinsicSizeAsMinimum="true">
            <shape android:shape="rectangle">
                <size
                    android:width="@dimen/auv_video_thumb_width"
                    android:height="@dimen/auv_video_progress_height" />
                <solid android:color="@color/auv_video_controls_foreground" />
                <corners android:radius="@dimen/auv_video_progress_radius" />
            </shape>
        </scale>
    </item>
</layer-list>
