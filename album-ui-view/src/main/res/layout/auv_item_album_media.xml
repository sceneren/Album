<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auv_media_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/auv_media_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/auv_media_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/auv_media_video_info"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auv_media_label_height"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/auv_media_label_margin"
        android:drawableStart="@drawable/auv_ic_album_video"
        android:drawablePadding="@dimen/auv_media_video_icon_gap"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/auv_primary"
        android:textSize="@dimen/auv_media_label_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/auv_media_badge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auv_media_label_height"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/auv_media_label_margin"
        android:background="@drawable/auv_bg_media_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/auv_media_label_padding_horizontal"
        android:paddingEnd="@dimen/auv_media_label_padding_horizontal"
        android:textColor="@color/auv_primary"
        android:textSize="@dimen/auv_media_label_text_size"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/auv_media_check"
        android:layout_width="@dimen/auv_media_check_size"
        android:layout_height="@dimen/auv_media_check_size"
        android:layout_gravity="top|end"
        android:padding="@dimen/auv_media_check_padding"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/auv_toggle_selection"
        android:focusable="true"
        android:gravity="center" />
</FrameLayout>
