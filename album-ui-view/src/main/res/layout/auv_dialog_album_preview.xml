<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auv_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/auv_preview_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/auv_toolbar"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/auv_preview_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/auv_back"
            android:padding="12dp"
            android:src="@drawable/auv_ic_album_back" />

        <TextView
            android:id="@+id/auv_preview_page_counter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:textColor="@color/auv_primary"
            android:textSize="18sp"
            tools:text="1/1" />

        <ImageButton
            android:id="@+id/auv_preview_selection"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/auv_toggle_selection"
            android:padding="16dp"
            android:src="@drawable/auv_ic_album_unchecked" />
    </RelativeLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/auv_preview_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black" />

    <LinearLayout
        android:id="@+id/auv_preview_bottom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/auv_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/auv_preview_done_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/auv_preview_selected_count"
                android:layout_width="wrap_content"
                android:minWidth="18dp"
                android:layout_height="18dp"
                android:gravity="center"
                android:textColor="@color/auv_primary"
                android:textSize="13sp"
                tools:text="41"
                tools:background="@drawable/auv_bg_select_count"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/auv_preview_done_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/auv_please_select"
                android:textColor="@color/auv_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
